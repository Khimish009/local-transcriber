APP_ENV=local

API_PORT=8000
WEB_PORT=3000

REDIS_URL=redis://redis:6379/0

DATA_DIR=/data
MODELS_DIR=/models

# Hugging Face token. Required on the FIRST run to download the pyannote diarization
# weights. Accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1 first.
# Once the weights are cached in MODELS_DIR, inference runs fully offline and the token
# is no longer needed.
HF_TOKEN=

# GigaAM model name. Weights are public: they are downloaded into MODELS_DIR/gigaam on the
# first transcription job and need no token. Alternative: v3_rnnt (see TASKS.md Phase 10).
ASR_MODEL=v3_e2e_rnnt

MAX_UPLOAD_MB=2048
# Comma-separated, without dots. Reported to the UI via /api/v1/health.
ALLOWED_EXTENSIONS=wav,mp3,m4a,mp4,webm,ogg
MAX_ASR_CHUNK_SECONDS=20
MERGE_SILENCE_GAP_MS=400

# Alignment. Tolerance: how far past a speaker interval a word midpoint may still fall and
# be attributed; beyond it the word gets speaker_id = null instead of a guess.
SPEAKER_MATCH_TOLERANCE_MS=250
# A pause at least this long starts a new transcript block.
BLOCK_SILENCE_GAP_MS=1500
# Hard cap on a block, so a long monologue never becomes one giant paragraph.
MAX_BLOCK_SECONDS=40

DEVICE=cpu

# CORS: origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# URL the browser uses to reach the API (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
